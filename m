static unsigned char b64tab[256];

static void b64init(void)
{
	static const char *a =
	    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	int i;
	memset(b64tab, 0xff, sizeof(b64tab));
	for (i = 0; i < 64; i++)
		b64tab[(unsigned char)a[i]] = (unsigned char)i;
}

static unsigned char *b64decode(const char *s, size_t *outlen)
{
	size_t n = strlen(s), i, o = 0;
	unsigned char *out = (unsigned char *)malloc(n / 4 * 3 + 8);
	uint32_t acc = 0;
	int bits = 0;
	if (!out)
		return NULL;
	for (i = 0; i < n; i++) {
		unsigned char v = b64tab[(unsigned char)s[i]];
		if (v == 0xff)
			continue;
		acc = (acc << 6) | v;
		bits += 6;
		if (bits >= 8) {
			bits -= 8;
			out[o++] = (unsigned char)((acc >> bits) & 0xff);
		}
	}
	*outlen = o;
	return out;
}

static char workdir[256];
static char imgpath[320];
static char mntpath[320];
static char loopdev[64];

static volatile int go;
static volatile int stop_churn;
static int nthreads = 4;

static long long now_ms(void)
{
	struct timespec ts;
	clock_gettime(CLOCK_MONOTONIC, &ts);
	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

#define CHURN_PAGES 64

struct churn_ctx {
	char *map;
	size_t len;
	unsigned char vec[CHURN_PAGES];
};

static void churn_init(struct churn_ctx *c)
{
	c->len = (size_t)CHURN_PAGES * 4096;
	c->map = (char *)mmap(NULL, c->len, PROT_READ | PROT_WRITE,
			      MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
	if (c->map == MAP_FAILED)
		c->map = NULL;
}

static void churn_fini(struct churn_ctx *c)
{
	if (c->map)
		munmap(c->map, c->len);
	c->map = NULL;
}

static void churn_stack(struct churn_ctx *c, long long ms)
{
	long long end = now_ms() + ms;

	if (!c->map)
		return;
	while (now_ms() < end && !stop_churn) {
		size_t i;

		for (i = 0; i < (size_t)CHURN_PAGES; i++)
			c->map[i * 4096] = (char)(i + 1);

		mincore(c->map, c->len, c->vec);

		mprotect(c->map, c->len, PROT_READ);
		mincore(c->map, c->len, c->vec);
		mprotect(c->map, c->len, PROT_READ | PROT_WRITE);

		madvise(c->map, c->len, MADV_DONTNEED);
	}
}

struct targ {
	int idx;
};

static void *tfn(void *p)
{
	struct targ *a = (struct targ *)p;
	int idx = a->idx;
	char nm[16];
	char path[512];
	char val[32];
	struct churn_ctx cc;

	snprintf(nm, sizeof(nm), "syzrepro%d", idx);
	prctl(PR_SET_NAME, nm, 0, 0, 0);
	memset(val, 'A', sizeof(val));
	memset(&cc, 0, sizeof(cc));
	churn_init(&cc);

	while (!__atomic_load_n(&go, __ATOMIC_ACQUIRE))
		sched_yield();

	snprintf(path, sizeof(path), "%s/w%d", mntpath, idx);

	if (idx == 0) {

		setxattr(path, "security.ima", val, sizeof(val), 0);
		churn_stack(&cc, 900);
	} else if (idx == 1) {

		usleep(1500);
		setxattr(path, "security.ima", val, sizeof(val), 0);
		snprintf(path, sizeof(path), "%s/wb%d", mntpath, idx);
		setxattr(path, "security.ima", val, sizeof(val), 0);
	} else {

		usleep(3000 + 800 * idx);
		setxattr(path, "security.ima", val, sizeof(val), 0);
		churn_stack(&cc, 800);
	}
	churn_fini(&cc);
	return NULL;
}

static int write_image(void)
{
	unsigned char *st;
	size_t len, p = 0;
	int fd;

	b64init();
	st = b64decode(img_b64, &len);
	if (!st) {
		return -1;
	}
	fd = open(imgpath, O_RDWR | O_CREAT | O_TRUNC, 0600);
	if (fd < 0) {
		free(st);
		return -1;
	}
	if (ftruncate(fd, IMG_SIZE) < 0) {
		close(fd);
		free(st);
		return -1;
	}
	while (p + 8 <= len) {
		uint32_t off, n;
		memcpy(&off, st + p, 4);
		memcpy(&n, st + p + 4, 4);
		p += 8;
		if (p + n > len)
			break;
		if (pwrite(fd, st + p, n, off) != (ssize_t)n) {
			close(fd);
			free(st);
			return -1;
		}
		p += n;
	}
	fsync(fd);
	close(fd);
	free(st);
	return 0;
}

static int loop_attach(void)
{
	int cfd, lfd, ffd, idx;

	cfd = open("/dev/loop-control", O_RDWR);
	idx = -1;
	if (cfd >= 0) {
		idx = ioctl(cfd, LOOP_CTL_GET_FREE, 0);
		close(cfd);
	}
	if (idx < 0)
		idx = 0;
	snprintf(loopdev, sizeof(loopdev), "/dev/loop%d", idx);

	ffd = open(imgpath, O_RDWR);
	if (ffd < 0) {
		return -1;
	}
	lfd = open(loopdev, O_RDWR);
	if (lfd < 0) {
		close(ffd);
		return -1;
	}
	if (ioctl(lfd, LOOP_SET_FD, ffd) < 0) {
		close(lfd);
		close(ffd);
		return -1;
	}

	close(lfd);
	close(ffd);
	return 0;
}

static void loop_detach(void)
{
	int i;
	for (i = 0; i < 50; i++) {
		int lfd = open(loopdev, O_RDWR);
		if (lfd < 0)
			return;
		if (ioctl(lfd, LOOP_CLR_FD, 0) == 0) {
			close(lfd);
			return;
		}
		close(lfd);
		usleep(20000);
	}
}

static int pick_workdir(void)
{
	static const char *cand[] = { "/root", "/tmp", "/var/tmp", ".", NULL };
	int i;
	for (i = 0; cand[i]; i++) {
		char probe[320];
		int fd;
		snprintf(probe, sizeof(probe), "%s/.syzrepro_probe", cand[i]);
		fd = open(probe, O_RDWR | O_CREAT | O_TRUNC, 0600);
		if (fd < 0)
			continue;
		if (ftruncate(fd, IMG_SIZE) < 0) {
			close(fd);
			unlink(probe);
			continue;
		}
		close(fd);
		unlink(probe);
		snprintf(workdir, sizeof(workdir), "%s", cand[i]);
		return 0;
	}
	return -1;
}

